spring.application.name=zato

# Dados fornecidos pela FIAP
spring.datasource.url=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
spring.datasource.username=SEU_RM
spring.datasource.password=SUA_SENHA

# Mostrar SQL executado no log
spring.jpa.show-sql=true

# Nao deixar o JPA tentar criar/alterar tabelas (criei as tabelas pelo SQL Developer)
spring.jpa.hibernate.ddl-auto=none

# Mostrar a mensagem das excecoes na resposta da API (ex: "Tipo invalido. Use RECEITA ou DESPESA.")
server.error.include-message=always
